# === Ollama Configuration ===
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3
OLLAMA_TIMEOUT=120

# === Kokoro TTS Configuration ===
# Leave empty for gTTS fallback
KOKORO_MODEL_PATH=
KOKORO_VOICE=af_heart

# === ComfyUI / Flux Configuration ===
COMFYUI_HOST=http://localhost:8188
COMFYUI_FLUX_WORKFLOW=
COMFYUI_TIMEOUT=300
NUM_IMAGES=10

# === YouTube ===
# Credentials are NOT used for uploads. The bot uses persistent browser sessions.
# Run `python main.py --setup-sessions` and log in manually once.
# CHANNEL_ID is optional metadata.
YOUTUBE_CHANNEL_ID=

# === Instagram ===
# Credentials are NOT used for uploads. The bot uses persistent browser sessions.
# Run `python main.py --setup-sessions` and log in manually once.

# === Schedule ===
SCHEDULE_TIME=08:00

# === General ===
LOG_LEVEL=INFO
MAX_RETRIES=3
RETRY_DELAY=60
BACKGROUND_MUSIC_PATH=
APPROVAL_MODE=false
QUALITY_THRESHOLD=6.0

# === Strategy Agent (Weekly Learning) ===
STRATEGY_ENABLED=true
STRATEGY_REVIEW_DAY=6
ROLLING_AVERAGE_DAYS=30
MAX_CATEGORY_WEIGHT=0.5
MIN_CATEGORY_WEIGHT=0.05

# === Topic Sources ===
TOPIC_SOURCES_ENABLED=true

# === Storage Management ===
CLEANUP_ENABLED=true
CLEANUP_RETENTION_DAYS=7
STORAGE_WARNING_THRESHOLD=80
FREE_STORAGE_WARNING_GB=100
MAX_TEMP_SIZE_MB=1024

# === Dashboard ===
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
